{
  "color": {
    "$type": "color",
    "brand": { "500": { "$value": "#2563eb" }, "600": { "$value": "#1d4ed8" } },
    "violet": { "500": { "$value": "#8b5cf6" }, "600": { "$value": "#7c3aed" } },
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f8fafc" },
      "100": { "$value": "#f1f5f9" },
      "200": { "$value": "#e2e8f0" },
      "400": { "$value": "#94a3b8" },
      "500": { "$value": "#64748b" },
      "700": { "$value": "#334155" },
      "800": { "$value": "#1e293b" },
      "900": { "$value": "#0f172a" }
    },
    "success": { "500": { "$value": "#16a34a" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Inter", "Helvetica Neue", "Arial", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "4xl": { "$value": "36px" },
      "5xl": { "$value": "48px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  }
}
